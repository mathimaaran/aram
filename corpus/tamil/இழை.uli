// Niraluli: இழை.uli — goroutine + channel sync (Tamil-0.48)
// Go equivalent:
//
//	ch := make(chan string)
//	go func() { ch <- "வணக்கம்" }()
//	println(<-ch)

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    ச := ஆக்கு(தடம் சரம்)
    இழை செயல்பாடு() {
        ச <- "வணக்கம்"
    }()
    பதிப்பி(<-ச)
}

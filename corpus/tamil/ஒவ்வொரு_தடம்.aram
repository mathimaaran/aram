// Aram: ஒவ்வொரு_தடம்.aram — range over தடம் until மூடு
தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    ச := ஆக்கு(தடம் முழுஎண், 3)
    ச <- 1
    ச <- 2
    ச <- 3
    மூடு(ச)
    சுழல் ம := ஒவ்வொரு ச {
        பதிப்பி(ம)
    }
    உ := ஆக்கு(தடம் முழுஎண்)
    இழை செயல்பாடு() {
        உ <- 8
        மூடு(உ)
    }()
    சுழல் ஒவ்வொரு உ {
        பதிப்பி(9)
    }
}

//பகாஎண்.aram — prime check 

தொகுப்பு தொடக்கம்

செயல்பாடு பகாவா(n முழுஎண்) நிலை {
    எனில் n <= 1 {
        திருப்பு பொய்
    }
    
    சுழல் i := 2; i*i <= n; i = i + 1 {
        எனில் n%i == 0 {
            திருப்பு பொய்
        }
    }
    திருப்பு மெய்
}

செயல்பாடு தொடக்கம்() {
    பதிப்பி(பகாவா(104958787)) // மெய்
    பதிப்பி(பகாவா(4))  // பொய்
}

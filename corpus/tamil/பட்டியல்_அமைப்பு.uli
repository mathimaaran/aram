// Niraluli: பட்டியல்_அமைப்பு.uli — []struct and []*T (Tamil-0.25)

தொகுப்பு தொடக்கம்

வகை புள்ளி அமைப்பு {
    x முழுஎண்
    y முழுஎண்
}

செயல்பாடு தொடக்கம்() {
    xs := []புள்ளி{புள்ளி{1, 2}, புள்ளி{3, 4}}
    பதிப்பி(நீளம்(xs))
    பதிப்பி(xs[0].x)
    பதிப்பி(xs[1].y)
    xs = சேர்(xs, புள்ளி{5, 6})
    பதிப்பி(நீளம்(xs))
    பதிப்பி(xs[2].x)

    அ := 10
    ஆ := 20
    ps := []*முழுஎண்{&அ, &ஆ}
    பதிப்பி(நீளம்(ps))
    பதிப்பி(*ps[0])
    ps[1] = &அ
    பதிப்பி(*ps[1])
    ps = சேர்(ps, இன்மை)
    பதிப்பி(நீளம்(ps))
    எனில் ps[2] == இன்மை {
        பதிப்பி(1)
    }
}

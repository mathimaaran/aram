// Niraluli: முறை_வெளிப்பாடு.uli — method expressions T.M / (*T).M (Tamil-0.47)
// Go equivalent:
//
//	type Point struct { x int; y int }
//	func (p Point) Sum() int { return p.x + p.y }
//	func (p *Point) SetX(v int) { p.x = v }
//	func main() {
//		p := Point{x: 3, y: 4}
//		sum := Point.Sum
//		println(sum(p)) // 7
//		set := (*Point).SetX
//		set(&p, 10)
//		println(p.x) // 10
//	}

தொகுப்பு தொடக்கம்

வகை புள்ளி அமைப்பு {
    x முழுஎண்
    y முழுஎண்
}

செயல்பாடு (ப புள்ளி) கூட்டு() முழுஎண் {
    திருப்பு ப.x + ப.y
}

செயல்பாடு (ப *புள்ளி) அமை_x(ம முழுஎண்) {
    ப.x = ம
}

செயல்பாடு தொடக்கம்() {
    ப := புள்ளி{x: 3, y: 4}
    க := புள்ளி.கூட்டு
    பதிப்பி(க(ப))
    அ := (*புள்ளி).அமை_x
    அ(&ப, 10)
    பதிப்பி(ப.x)
}

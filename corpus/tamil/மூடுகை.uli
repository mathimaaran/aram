// Niraluli: மூடுகை.uli — function literals / closures (Tamil-0.45)
// Go equivalent:
//
//	func main() {
//		n := 0
//		inc := func() { n = n + 1 }
//		inc()
//		inc()
//		println(n) // 2
//		add := func(a int) int { return a + n }
//		println(add(10)) // 12
//	}

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    ந := 0
    அதிகரி := செயல்பாடு() {
        ந = ந + 1
    }
    அதிகரி()
    அதிகரி()
    பதிப்பி(ந)

    பெறு := செயல்பாடு(அ முழுஎண்) முழுஎண் {
        திருப்பு அ + ந
    }
    பதிப்பி(பெறு(10))
}

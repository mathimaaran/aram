// Aram: வலை_வாடிக்கையாளர் — HTTP client + custom response headers (Tamil-0.57)
//
// Loopback POST with request header; server replies with custom headers;
// client reads status, header map, and body.

தொகுப்பு தொடக்கம்

கொணர் "வலை"
கொணர் "பரிமாற்றம்"

செயல்பாடு தொடக்கம்() {
    கேட்பி, _ := வலை.கேள்(":0")
    முக, _ := வலை.முகவரி(கேட்பி)

    இழை செயல்பாடு() {
        உர := "http://" + முக + "/echo"
        தலை := அகராதி[சரம்]சரம்{"X-Client": "அறம்"}
        பதில், பிழை := பரிமாற்றம்.கோரு("POST", உர, தலை, []இருமி8("hello"))
        எனில் பிழை != இன்மை {
            பதிப்பி(பிழை.செய்தி)
            திருப்பு
        }
        பதிப்பி(பதில்.குறியீடு)
        பதிப்பி(பதில்.விளக்கம்)
        பதிப்பி(பதில்.தலைப்புகள்["x-echo"])
        பதிப்பி(பதில்.தலைப்புகள்["x-client"])
        பதிப்பி(சரம்(பதில்.உடல்))
    }()

    வழி := பரிமாற்றம்.புதியவழிப்படுத்தி()
    பரிமாற்றம்.பதிவு(வழி, "/echo", செயல்பாடு(கோ பரிமாற்றம்.கோரிக்கை, ப பரிமாற்றம்.பதிலளிப்பு) {
        தலை := அகராதி[சரம்]சரம்{
            "X-Echo":   "ok",
            "X-Client": கோ.தலைப்புகள்["x-client"],
        }
        பரிமாற்றம்.எழுதுதலைப்புகள்(ப, 200, "text/plain; charset=utf-8", தலை, கோ.உடல்)
    })
    பரிமாற்றம்.வழிசேவைஒன்று(கேட்பி, வழி)
    வலை.நிறுத்து(கேட்பி)
}

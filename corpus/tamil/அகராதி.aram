தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
	m := ஆக்கு(அகராதி[சரம்]முழுஎண்)
	m["அ"] = 7
	m["ஆ"] = 3
	பதிப்பி(நீளம்(m))
	பதிப்பி(m["அ"])

	வ, உண்டு := m["இ"]
	பதிப்பி(வ)
	பதிப்பி(உண்டு)

	வ, உண்டு = m["அ"]
	பதிப்பி(வ)
	பதிப்பி(உண்டு)

	நீக்கு(m, "அ")
	பதிப்பி(நீளம்(m))

	சுழல் க, மதி := ஒவ்வொரு m {
		பதிப்பி(க)
		பதிப்பி(மதி)
	}

	எண்கள் := ஆக்கு(அகராதி[முழுஎண்]சரம், 4)
	எண்கள்[1] = "ஒன்று"
	பதிப்பி(எண்கள்[1])
	பதிப்பி(நீளம்(எண்கள்))

	மாறி வெற்று அகராதி[சரம்]முழுஎண் = இன்மை
	பதிப்பி(நீளம்(வெற்று))
	எனில் வெற்று == இன்மை {
		பதிப்பி("nil")
	}
}

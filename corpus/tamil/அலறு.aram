// Aram: அலறு.aram — panic / recover (Tamil-0.49)
// Go equivalent:
//
//	defer func() {
//	    if r := recover(); r != nil {
//	        println(r)
//	    }
//	}()
//	panic("பிழை")

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    தள்ளிவை செயல்பாடு() {
        ம := மீள்()
        எனில் ம != "" {
            பதிப்பி(ம)
        }
    }()
    அலறு("பிழை")
    பதிப்பி("இல்லை")
}

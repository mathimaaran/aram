// Niraluli: சேர்_வளர்.uli — multi-சேர் and three-index slice (Tamil-0.19)

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    xs := []முழுஎண்{1, 2, 3, 4}
    xs = சேர்(xs, 5, 6)
    பதிப்பி(நீளம்(xs))
    பதிப்பி(xs[5])

    ys := xs[1:3:4]
    பதிப்பி(நீளம்(ys))
    பதிப்பி(ys[0])
    ys = சேர்(ys, 9)
    பதிப்பி(நீளம்(ys))
    பதிப்பி(ys[2])
    பதிப்பி(xs[4])

    zs := xs[:2:3]
    பதிப்பி(நீளம்(zs))
    பதிப்பி(zs[1])
}

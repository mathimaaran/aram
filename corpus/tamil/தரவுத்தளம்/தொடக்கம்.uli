// Tamil-0.62: shared database vtable + SQLite backend.
// Go equivalent: database/sql with a SQLite driver, prepared insert, query/scan.
தொகுப்பு தொடக்கம்

கொணர் "தரவுத்தளம்"

செயல்பாடு பிழைகாட்டு(ப *தரவுத்தளம்.பிழை) {
    எனில் ப != இன்மை {
        பதிப்பி(ப.செய்தி)
    }
}

செயல்பாடு தொடக்கம்() {
    இ, ப := தரவுத்தளம்.திற("sqlite", ":memory:")
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }

    _, ப = தரவுத்தளம்.செயல்(இ, "CREATE TABLE பொருள் (எண் INTEGER, பெயர் TEXT, மதிப்பு REAL, தரவு BLOB, குறிப்பு TEXT)")
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }

    மாறி க தரவுத்தளம்.கூற்று
    க, ப = தரவுத்தளம்.தயாரி(இ, "INSERT INTO பொருள் VALUES (?, ?, ?, ?, ?)")
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }
    ப = தரவுத்தளம்.முழுஎண்பிணை(க, 1, 1)
    ப = தரவுத்தளம்.சரம்பிணை(க, 2, "நிரலுளி")
    ப = தரவுத்தளம்.மிதவைப்பிணை(க, 3, 9.5)
    ப = தரவுத்தளம்.இருமிப்பிணை(க, 4, []இருமி8("தரவு"))
    ப = தரவுத்தளம்.இன்மைபிணை(க, 5)
    _, ப = தரவுத்தளம்.அடுத்து(க)
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }
    ப = தரவுத்தளம்.கூற்றுவிடு(க)

    க, ப = தரவுத்தளம்.தயாரி(இ, "SELECT எண், பெயர், மதிப்பு, தரவு, குறிப்பு FROM பொருள்")
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }
    நெடுவரிசைகள், _ := தரவுத்தளம்.நெடுவரிசைகள்(க)
    பதிப்பி(நெடுவரிசைகள்)
    பெயர், _ := தரவுத்தளம்.நெடுவரிசைப்பெயர்(க, 0)
    பதிப்பி(பெயர்)

    மாறி உண்டு நிலை
    உண்டு, ப = தரவுத்தளம்.அடுத்து(க)
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }
    எனில் உண்டு {
        எண், _ := தரவுத்தளம்.முழுஎண்பெறு(க, 0)
        உரை, _ := தரவுத்தளம்.சரம்பெறு(க, 1)
        மதிப்பு, _ := தரவுத்தளம்.மிதவைப்பெறு(க, 2)
        இருமிகள், _ := தரவுத்தளம்.இருமிப்பெறு(க, 3)
        காலி, _ := தரவுத்தளம்.இன்மையா(க, 4)
        பதிப்பி(எண்)
        பதிப்பி(உரை)
        பதிப்பி(மதிப்பு)
        பதிப்பி(சரம்(இருமிகள்))
        பதிப்பி(காலி)
    }

    ப = தரவுத்தளம்.கூற்றுவிடு(க)
    ப = தரவுத்தளம்.விடு(இ)

    _, ப = தரவுத்தளம்.திற("unknown", ":memory:")
    எனில் ப != இன்மை {
        பதிப்பி(ப.செய்தி)
    }
}

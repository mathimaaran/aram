// Niraluli: இன்மை.uli — nil pointer + == / !=
// Go equivalent:
//
//	func main() {
//		var p *int = nil
//		if p == nil { println(1) }
//		var a int = 5
//		p = &a
//		if p != nil { println(*p) }
//		p = nil
//		if p == nil { println(0) }
//	}

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    மாறி ப *முழுஎண் = இன்மை
    எனில் ப == இன்மை {
        பதிப்பி(1)
    }
    மாறி அ முழுஎண் = 5
    ப = &அ
    எனில் ப != இன்மை {
        பதிப்பி(*ப)
    }
    ப = இன்மை
    எனில் ப == இன்மை {
        பதிப்பி(0)
    }
}

// Aram: மாற்றுதல்_மேல்.aram — bool/string/pointer conversions + mixed int/float (Tamil-0.34)

தொகுப்பு தொடக்கம்

வகை மதிப்பெண் முழுஎண்
வகை கொடி நிலை

செயல்பாடு தொடக்கம்() {
    // defined bool ↔ நிலை
    மாறி க கொடி = மெய்
    பதிப்பி(நிலை(க))

    // rune → சரம்
    பதிப்பி(சரம்(65))

    // pointer: *மதிப்பெண் ↔ *முழுஎண் (same underlying)
    அ := 9
    p := &அ
    q := (*மதிப்பெண்)(p)
    பதிப்பி(முழுஎண்(*q))

    // implicit mixed int/float
    பதிப்பி(2 + 3.5)
    பதிப்பி(10 / 4.0)
    எனில் 1 < 2.5 {
        பதிப்பி(1)
    }
}

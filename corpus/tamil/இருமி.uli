// Niraluli: இருமி.uli — இருமி8 / இருமி32 + சரம் conversions (Tamil-0.39)

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    bs := []இருமி8{65, 66, 67}
    பதிப்பி(நீளம்(bs))
    பதிப்பி(முழுஎண்(bs[0]))
    s1 := சரம்(bs)
    பதிப்பி(s1)

    b2 := []இருமி8(s1)
    பதிப்பி(நீளம்(b2))
    பதிப்பி(சரம்(b2))

    த := "அஆ"
    rs := []இருமி32(த)
    பதிப்பி(நீளம்(rs))
    பதிப்பி(முழுஎண்(rs[0]))
    பதிப்பி(சரம்(rs))

    பதிப்பி(சரம்(இருமி32(65)))
    பதிப்பி(சரம்(இருமி8(66)))
}

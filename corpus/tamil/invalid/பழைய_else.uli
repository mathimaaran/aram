//			fmt.Println("சரி")
//		} else {
//			fmt.Println("தவறான else சொல்")
//		}
//	}

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    எனில் மெய் {
        பதிப்பி("சரி")
    } இல்லையெனில் {
        பதிப்பி("தவறான else சொல்")
    }
}

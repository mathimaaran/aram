// Niraluli v0.62 full-stack corpus backend:
// REST API + persistent SQLite + Tamil table, columns, and employee data.
தொகுப்பு தொடக்கம்

கொணர் "தரவுத்தளம்"
கொணர் "பரிமாற்றம்"

செயல்பாடு எண்ணெழுத்து(மதிப்பு முழுஎண்) சரம் {
    எனில் மதிப்பு == 0 {
        திருப்பு "0"
    }
    எதிர்மறை := பொய்
    எண் := மதிப்பு
    எனில் எண் < 0 {
        எதிர்மறை = மெய்
        எண் = -எண்
    }
    விளைவு := ""
    சுழல் எண் > 0 {
        இலக்கம் := எண் % 10
        விளைவு = சரம்(48 + இலக்கம்) + விளைவு
        எண் = எண் / 10
    }
    எனில் எதிர்மறை {
        விளைவு = "-" + விளைவு
    }
    திருப்பு விளைவு
}

செயல்பாடு ஜேசன்சரம்(உரை சரம்) சரம் {
    விளைவு := "\""
    சுழல் _, எழுத்து := ஒவ்வொரு உரை {
        எனில் எழுத்து == 34 {
            விளைவு = விளைவு + "\\\""
        } இல்லையேல் எனில் எழுத்து == 92 {
            விளைவு = விளைவு + "\\\\"
        } இல்லையேல் எனில் எழுத்து == 10 {
            விளைவு = விளைவு + "\\n"
        } இல்லையேல் எனில் எழுத்து == 13 {
            விளைவு = விளைவு + "\\r"
        } இல்லையேல் எனில் எழுத்து == 9 {
            விளைவு = விளைவு + "\\t"
        } இல்லையேல் {
            விளைவு = விளைவு + சரம்(எழுத்து)
        }
    }
    திருப்பு விளைவு + "\""
}

செயல்பாடு பொதுத்தலைப்புகள்() அகராதி[சரம்]சரம் {
    திருப்பு அகராதி[சரம்]சரம்{
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type",
        "Cache-Control": "no-store",
    }
}

செயல்பாடு பிழைப்பதில்(ப பரிமாற்றம்.பதிலளிப்பு, குறியீடு முழுஎண், செய்தி சரம்) {
    உடல் := "{\"பிழை\":" + ஜேசன்சரம்(செய்தி) + "}"
    பரிமாற்றம்.எழுதுசரந்தலைப்புகள்(
        ப,
        குறியீடு,
        "application/json; charset=utf-8",
        பொதுத்தலைப்புகள்(),
        உடல்
    )
}

செயல்பாடு தரவுத்தளமமை(பாதை சரம்) *தரவுத்தளம்.பிழை {
    இ, பிழை := தரவுத்தளம்.திற("sqlite", பாதை)
    எனில் பிழை != இன்மை {
        திருப்பு பிழை
    }

    _, பிழை = தரவுத்தளம்.செயல்(
        இ,
        "CREATE TABLE IF NOT EXISTS ஊழியர்கள் (எண் INTEGER PRIMARY KEY, பெயர் TEXT NOT NULL, பதவி TEXT NOT NULL, துறை TEXT NOT NULL, ஊர் TEXT NOT NULL, சம்பளம் INTEGER NOT NULL, சேர்ந்தஆண்டு INTEGER NOT NULL)"
    )
    எனில் பிழை != இன்மை {
        தரவுத்தளம்.விடு(இ)
        திருப்பு பிழை
    }

    _, பிழை = தரவுத்தளம்.செயல்(
        இ,
        "INSERT OR IGNORE INTO ஊழியர்கள் VALUES (1, 'அருண்', 'மென்பொருள் பொறியாளர்', 'தொழில்நுட்பம்', 'சென்னை', 85000, 2021), (2, 'காவியா', 'தயாரிப்பு மேலாளர்', 'தயாரிப்பு', 'கோயம்புத்தூர்', 98000, 2019), (3, 'செந்தில்', 'தரவு பகுப்பாய்வாளர்', 'தரவு', 'மதுரை', 76000, 2022), (4, 'யாழினி', 'வடிவமைப்பாளர்', 'வடிவமைப்பு', 'திருச்சிராப்பள்ளி', 72000, 2023), (5, 'முகிலன்', 'தர உறுதி பொறியாளர்', 'தரம்', 'சேலம்', 68000, 2020), (6, 'நந்தினி', 'மனிதவள மேலாளர்', 'மனிதவளம்', 'திருநெல்வேலி', 81000, 2018)"
    )
    மூடுபிழை := தரவுத்தளம்.விடு(இ)
    எனில் பிழை != இன்மை {
        திருப்பு பிழை
    }
    திருப்பு மூடுபிழை
}

செயல்பாடு ஊழியர்பட்டியல்(பாதை சரம்) (சரம், *தரவுத்தளம்.பிழை) {
    இ, பிழை := தரவுத்தளம்.திற("sqlite", பாதை)
    எனில் பிழை != இன்மை {
        திருப்பு "", பிழை
    }

    மாறி க தரவுத்தளம்.கூற்று
    க, பிழை = தரவுத்தளம்.தயாரி(
        இ,
        "SELECT எண், பெயர், பதவி, துறை, ஊர், சம்பளம், சேர்ந்தஆண்டு FROM ஊழியர்கள் ORDER BY எண்"
    )
    எனில் பிழை != இன்மை {
        தரவுத்தளம்.விடு(இ)
        திருப்பு "", பிழை
    }

    பதிவுகள் := ""
    முதல் := மெய்
    சுழல் {
        உண்டு, அடிப்பிழை := தரவுத்தளம்.அடுத்து(க)
        எனில் அடிப்பிழை != இன்மை {
            தரவுத்தளம்.கூற்றுவிடு(க)
            தரவுத்தளம்.விடு(இ)
            திருப்பு "", அடிப்பிழை
        }
        எனில் !உண்டு {
            முறி
        }

        எண், _ := தரவுத்தளம்.முழுஎண்பெறு(க, 0)
        பெயர், _ := தரவுத்தளம்.சரம்பெறு(க, 1)
        பதவி, _ := தரவுத்தளம்.சரம்பெறு(க, 2)
        துறை, _ := தரவுத்தளம்.சரம்பெறு(க, 3)
        ஊர், _ := தரவுத்தளம்.சரம்பெறு(க, 4)
        சம்பளம், _ := தரவுத்தளம்.முழுஎண்பெறு(க, 5)
        சேர்ந்தஆண்டு, _ := தரவுத்தளம்.முழுஎண்பெறு(க, 6)

        எனில் !முதல் {
            பதிவுகள் = பதிவுகள் + ","
        }
        முதல் = பொய்
        பதிவுகள் = பதிவுகள் +
            "{\"எண்\":" + எண்ணெழுத்து(எண்) +
            ",\"பெயர்\":" + ஜேசன்சரம்(பெயர்) +
            ",\"பதவி\":" + ஜேசன்சரம்(பதவி) +
            ",\"துறை\":" + ஜேசன்சரம்(துறை) +
            ",\"ஊர்\":" + ஜேசன்சரம்(ஊர்) +
            ",\"சம்பளம்\":" + எண்ணெழுத்து(சம்பளம்) +
            ",\"சேர்ந்தஆண்டு\":" + எண்ணெழுத்து(சேர்ந்தஆண்டு) + "}"
    }

    தரவுத்தளம்.கூற்றுவிடு(க)
    தரவுத்தளம்.விடு(இ)
    உடல் := "{\"அட்டவணை\":\"ஊழியர்கள்\",\"நெடுவரிசைகள்\":[\"எண்\",\"பெயர்\",\"பதவி\",\"துறை\",\"ஊர்\",\"சம்பளம்\",\"சேர்ந்தஆண்டு\"],\"பதிவுகள்\":[" + பதிவுகள் + "]}"
    திருப்பு உடல், இன்மை
}

செயல்பாடு தொடக்கம்() {
    தரவுப்பாதை := "build/ஊழியர்கள்.db"
    பிழை := தரவுத்தளமமை(தரவுப்பாதை)
    எனில் பிழை != இன்மை {
        பதிப்பி("தரவுத்தளப் பிழை: " + பிழை.செய்தி)
        திருப்பு
    }

    வழி := பரிமாற்றம்.புதியவழிப்படுத்தி()
    பரிமாற்றம்.பதிவு(&வழி, "/api/employees", செயல்பாடு(கோ பரிமாற்றம்.கோரிக்கை, ப பரிமாற்றம்.பதிலளிப்பு) {
        எனில் கோ.முறைமை == "OPTIONS" {
            பரிமாற்றம்.எழுதுசரந்தலைப்புகள்(
                ப, 204, "text/plain", பொதுத்தலைப்புகள்(), ""
            )
            திருப்பு
        }
        எனில் கோ.முறைமை != "GET" {
            பிழைப்பதில்(ப, 405, "GET முறை மட்டும் அனுமதிக்கப்படுகிறது")
            திருப்பு
        }
        உடல், தரவுப்பிழை := ஊழியர்பட்டியல்(தரவுப்பாதை)
        எனில் தரவுப்பிழை != இன்மை {
            பிழைப்பதில்(ப, 500, தரவுப்பிழை.செய்தி)
            திருப்பு
        }
        பரிமாற்றம்.எழுதுசரந்தலைப்புகள்(
            ப,
            200,
            "application/json; charset=utf-8",
            பொதுத்தலைப்புகள்(),
            உடல்
        )
    })

    பரிமாற்றம்.பதிவு(&வழி, "/api/health", செயல்பாடு(கோ பரிமாற்றம்.கோரிக்கை, ப பரிமாற்றம்.பதிலளிப்பு) {
        பரிமாற்றம்.எழுதுசரந்தலைப்புகள்(
            ப,
            200,
            "application/json; charset=utf-8",
            பொதுத்தலைப்புகள்(),
            "{\"நிலை\":\"நலம்\",\"சேவை\":\"ஊழியர் விவரங்கள்\"}"
        )
    })

    பதிப்பி("நிரலுளி REST சேவை: http://127.0.0.1:8080")
    பதிப்பி("SQLite தரவுத்தளம்: " + தரவுப்பாதை)
    வலைப்பிழை := பரிமாற்றம்.வழிசேவை("127.0.0.1:8080", &வழி)
    எனில் வலைப்பிழை != இன்மை {
        பதிப்பி("HTTP பிழை: " + வலைப்பிழை.செய்தி)
    }
}

// Niraluli: ஆக்கு.uli — make / copy / cap (Tamil-0.22)

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    xs := ஆக்கு([]முழுஎண், 3, 8)
    பதிப்பி(நீளம்(xs))
    பதிப்பி(திறன்(xs))
    பதிப்பி(xs[0])
    xs[1] = 7
    பதிப்பி(xs[1])

    src := []முழுஎண்{10, 20, 30}
    n := நகல்(xs, src)
    பதிப்பி(n)
    பதிப்பி(xs[0])
    பதிப்பி(xs[2])

    ys := ஆக்கு([]முழுஎண், 2)
    பதிப்பி(நீளம்(ys))
    பதிப்பி(திறன்(ys))
}

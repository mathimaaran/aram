தொகுப்பு தொடக்கம்

வகை புள்ளி அமைப்பு {
	x முழுஎண்
	y முழுஎண்
}

செயல்பாடு தொடக்கம்() {
	மி := அகராதி[மிதவைஎண்]சரம்{1.5: "அரை", 2.0: "இரண்டு"}
	பதிப்பி(மி[1.5])
	பதிப்பி(நீளம்(மி))

	பு := அகராதி[புள்ளி]முழுஎண்{புள்ளி{1, 2}: 7, புள்ளி{3, 4}: 9}
	பதிப்பி(பு[புள்ளி{1, 2}])
	பதிப்பி(பு[புள்ளி{0, 0}])

	அணி := அகராதி[[2]முழுஎண்]சரம்{[2]முழுஎண்{9, 8}: "ஆ"}
	பதிப்பி(அணி[[2]முழுஎண்{9, 8}])

	மாறி எண் முழுஎண் = 3
	சு := &எண்
	சுட்டிகள் := ஆக்கு(அகராதி[*முழுஎண்]சரம்)
	சுட்டிகள்[சு] = "சுட்டி"
	பதிப்பி(சுட்டிகள்[சு])
	வ, உண்டு := சுட்டிகள்[சு]
	பதிப்பி(உண்டு)
}

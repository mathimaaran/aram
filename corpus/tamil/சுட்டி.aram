// Aram: சுட்டி.aram — pointers (*T, &x, *p)
// Go equivalent:
//
//	type Point struct { x int; y int }
//	func set(p *Point, v int) { p.x = v }
//	func main() {
//		var a int = 5
//		p := &a
//		*p = 7
//		println(a)
//		pt := Point{x: 1, y: 2}
//		q := &pt
//		q.x = 9
//		println(pt.x)
//		set(q, 3)
//		println(pt.x)
//	}

தொகுப்பு தொடக்கம்

வகை புள்ளி அமைப்பு {
    x முழுஎண்
    y முழுஎண்
}

செயல்பாடு அமை(ப *புள்ளி, ம முழுஎண்) {
    ப.x = ம
}

செயல்பாடு தொடக்கம்() {
    மாறி அ முழுஎண் = 5
    சு := &அ
    *சு = 7
    பதிப்பி(அ)
    ப := புள்ளி{x: 1, y: 2}
    சுப := &ப
    சுப.x = 9
    பதிப்பி(ப.x)
    அமை(சுப, 3)
    பதிப்பி(ப.x)
}

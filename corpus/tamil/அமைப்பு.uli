// Niraluli: அமைப்பு.uli — named structs
// Go equivalent:
//
//	type Point struct { x int; y int }
//	func main() {
//		p := Point{x: 3, y: 4}
//		println(p.x)
//		p.y = 9
//		println(p.y)
//		var z Point
//		println(z.x)
//	}

தொகுப்பு தொடக்கம்

வகை புள்ளி அமைப்பு {
    x முழுஎண்
    y முழுஎண்
}

செயல்பாடு தொடக்கம்() {
    ப := புள்ளி{x: 3, y: 4}
    பதிப்பி(ப.x)
    ப.y = 9
    பதிப்பி(ப.y)
    மாறி சுழி புள்ளி
    பதிப்பி(சுழி.x)
}

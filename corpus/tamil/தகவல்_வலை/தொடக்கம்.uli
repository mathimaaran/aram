// Niraluli: தகவல்_வலை — UDP loopback (Tamil-0.61)

தொகுப்பு தொடக்கம்

கொணர் "வலை"

செயல்பாடு தொடக்கம்() {
    சேவை, _ := வலை.தகவல்கேள்(":0")
    முகவரி, _ := வலை.தகவல்முகவரி(சேவை)
    இழை செயல்பாடு() {
        இடம் := ஆக்கு([]இருமி8, 64)
        n, அனுப்பியவர், _ := வலை.தகவல்பெறு(சேவை, இடம்)
        பதிப்பி(சரம்(இடம்[:n]))
        வலை.தகவலனுப்பு(சேவை, அனுப்பியவர், []இருமி8("pong"))
    }()
    வாடிக்கையாளர், _ := வலை.தகவல்கேள்(":0")
    வலை.தகவலனுப்பு(வாடிக்கையாளர், முகவரி, []இருமி8("ping"))
    இடம் := ஆக்கு([]இருமி8, 64)
    n, _, _ := வலை.தகவல்பெறு(வாடிக்கையாளர், இடம்)
    பதிப்பி(சரம்(இடம்[:n]))
    வலை.தகவல்விடு(வாடிக்கையாளர்)
    வலை.தகவல்விடு(சேவை)
}

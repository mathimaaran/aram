// Aram: தள்ளிவை_முறை.aram — defer method bind (Tamil-0.43)
// Value receiver: copy now. Pointer receiver: save &x now (later writes visible).

தொகுப்பு தொடக்கம்

வகை புள்ளி அமைப்பு {
    x முழுஎண்
}

செயல்பாடு (p புள்ளி) காட்டு() {
    பதிப்பி(p.x)
}

செயல்பாடு (p *புள்ளி) சுட்டி_காட்டு() {
    பதிப்பி(p.x)
}

செயல்பாடு தொடக்கம்() {
    // Value method: receiver copied at தள்ளிவை → still 5 after mutate
    அ := புள்ளி{x: 5}
    தள்ளிவை அ.காட்டு
    அ.x = 9
    பதிப்பி(அ.x)

    // Pointer method (bare): &ஆ saved now → sees 7
    ஆ := புள்ளி{x: 1}
    தள்ளிவை ஆ.சுட்டி_காட்டு
    ஆ.x = 7
    பதிப்பி(ஆ.x)

    // Pointer method (explicit call): same bind semantics
    இ := புள்ளி{x: 2}
    தள்ளிவை இ.சுட்டி_காட்டு()
    இ.x = 8
}

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
	m := அகராதி[சரம்]முழுஎண்{"அ": 7, "ஆ": 3}
	பதிப்பி(நீளம்(m))
	பதிப்பி(m["அ"])
	பதிப்பி(m["ஆ"])

	வ, உண்டு := m["இ"]
	பதிப்பி(வ)
	பதிப்பி(உண்டு)

	காலி := அகராதி[முழுஎண்]சரம்{}
	பதிப்பி(நீளம்(காலி))
	எனில் காலி != இன்மை {
		பதிப்பி("ok")
	}

	காலி[1] = "ஒன்று"
	பதிப்பி(காலி[1])
}

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    மாறி அ0 செயல்பாடு() முழுஎண்
    மாறி அ1 செயல்பாடு() முழுஎண்
    மாறி அ2 செயல்பாடு() முழுஎண்

    சுழல் இ := 0; இ < 3; இ = இ + 1 {
        செ := செயல்பாடு() முழுஎண் {
            திருப்பு இ
        }
        எனில் இ == 0 {
            அ0 = செ
        } இல்லையேல் எனில் இ == 1 {
            அ1 = செ
        } இல்லையேல் {
            அ2 = செ
        }
    }

    பதிப்பி(அ0())
    பதிப்பி(அ1())
    பதிப்பி(அ2())
}

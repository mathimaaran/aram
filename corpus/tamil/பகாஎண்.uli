//பகாஎண்.uli — prime check 

தொகுப்பு தொடக்கம்

செயல்பாடு பகாவா(ந முழுஎண்) நிலை {
    எனில் ந <= 1 {
        திருப்பு பொய்
    }
    
    சுழல் இ := 2; இ*இ <= ந; இ = இ + 1 {
        எனில் ந%இ == 0 {
            திருப்பு பொய்
        }
    }
    திருப்பு மெய்
}

செயல்பாடு தொடக்கம்() {
    பதிப்பி(பகாவா(104958787987987)) // மெய்
    பதிப்பி(பகாவா(4))  // பொய்
}

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    சுழல் i := 0; i < 5; i = i + 1 {
        பதிப்பி(i)
    }
    n := 3
    சுழல் n > 0 {
        பதிப்பி(n)
        n = n - 1
    }
    சுழல் i := 0; i < 10; i = i + 1 {
        எனில் i == 3 {
            முறி
        }
        பதிப்பி(i)
    }
    சுழல் i := 0; i < 5; i = i + 1 {
        எனில் i == 2 {
            தொடர்
        }
        பதிப்பி(i)
    }
}

// Aram: அமைப்பு_சமம்.aram — struct == / !=
// Go: Point{1,2} == Point{1,2}

தொகுப்பு தொடக்கம்

வகை புள்ளி அமைப்பு {
    x முழுஎண்
    y முழுஎண்
}

வகை பெயர் அமைப்பு {
    ச சரம்
    எண் முழுஎண்
}

செயல்பாடு தொடக்கம்() {
    அ := புள்ளி{x: 1, y: 2}
    ஆ := புள்ளி{x: 1, y: 2}
    இ := புள்ளி{x: 9, y: 2}
    எனில் அ == ஆ {
        பதிப்பி(1)
    }
    எனில் அ != இ {
        பதிப்பி(2)
    }
    உ := பெயர்{ச: "அறம்", எண்: 7}
    ஊ := பெயர்{ச: "அறம்", எண்: 7}
    எனில் உ == ஊ {
        பதிப்பி(3)
    }
    மாறி வேறு பெயர் = பெயர்{ச: "வேறு", எண்: 7}
    எனில் உ != வேறு {
        பதிப்பி(4)
    }
}

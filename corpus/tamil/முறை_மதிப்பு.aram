// Aram: முறை_மதிப்பு.aram — method values / function values (Tamil-0.44)
// Go equivalent:
//
//	type Point struct { x int; y int }
//	func (p Point) Sum() int { return p.x + p.y }
//	func (p *Point) SetX(v int) { p.x = v }
//	func Add(a, b int) int { return a + b }
//	func main() {
//		p := Point{x: 3, y: 4}
//		set := p.SetX
//		set(10)
//		println(p.x) // 10
//		sum := p.Sum
//		p.x = 99
//		println(sum()) // 14 (copy at method-value creation)
//		add := Add
//		println(add(2, 5))
//	}

தொகுப்பு தொடக்கம்

வகை புள்ளி அமைப்பு {
    x முழுஎண்
    y முழுஎண்
}

செயல்பாடு (ப புள்ளி) கூட்டு() முழுஎண் {
    திருப்பு ப.x + ப.y
}

செயல்பாடு (ப *புள்ளி) அமை_x(ம முழுஎண்) {
    ப.x = ம
}

செயல்பாடு கூட்டு_எண்(அ முழுஎண், ஆ முழுஎண்) முழுஎண் {
    திருப்பு அ + ஆ
}

செயல்பாடு தொடக்கம்() {
    ப := புள்ளி{x: 3, y: 4}
    அ := ப.அமை_x
    அ(10)
    பதிப்பி(ப.x)
    க := ப.கூட்டு
    ப.x = 99
    பதிப்பி(க())
    சேர்_ம := கூட்டு_எண்
    பதிப்பி(சேர்_ம(2, 5))
}

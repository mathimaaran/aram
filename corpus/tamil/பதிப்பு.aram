// Aram: பதிப்பு.aram — பதிப்பி with string and int
// Go equivalent:
//
//	package main
//
//	import "fmt"
//
//	func main() {
//		fmt.Println("வணக்கம்")
//		fmt.Println(42)
//		var n int = 100
//		fmt.Println(n)
//	}

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    பதிப்பி("வணக்கம்")
    பதிப்பி(42)
    மாறி எண் முழுஎண் = 100
    பதிப்பி(எண்)
}

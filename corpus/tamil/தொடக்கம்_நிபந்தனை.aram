// Aram: தொடக்கம்_நிபந்தனை.aram — init before எனில் / திசைவி
// Go: if x := 3; x > 0 { ... }  /  switch n := 2; n { ... }

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    எனில் x := 3; x > 0 {
        பதிப்பி(x)
    } இல்லையேல் {
        பதிப்பி(0)
    }

    திசைவி n := 2; n {
        எனில் 1 {
            பதிப்பி(10)
        }
        எனில் 2 {
            பதிப்பி(20)
        }
        மற்றபடி {
            பதிப்பி(0)
        }
    }

    திசைவி y := -5; {
        எனில் y < 0 {
            பதிப்பி(9)
        }
        மற்றபடி {
            பதிப்பி(7)
        }
    }
}

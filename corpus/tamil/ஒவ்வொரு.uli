தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    எண்கள் := []முழுஎண்{10, 20, 30}
    சுழல் i, v := ஒவ்வொரு எண்கள் {
        பதிப்பி(i)
        பதிப்பி(v)
    }
    சுழல் _, v := ஒவ்வொரு எண்கள் {
        பதிப்பி(v)
    }
    கூட்டு := 0
    சுழல் i := ஒவ்வொரு எண்கள் {
        கூட்டு = கூட்டு + எண்கள்[i]
    }
    பதிப்பி(கூட்டு)
}

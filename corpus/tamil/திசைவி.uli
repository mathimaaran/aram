// Niraluli: திசைவி.uli — switch / default
// Go equivalent: tagged switch + tagless switch

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    மாறி n முழுஎண் = 2
    திசைவி n {
        எனில் 1 {
            பதிப்பி(10)
        }
        எனில் 2, 3 {
            பதிப்பி(20)
        }
        மற்றபடி {
            பதிப்பி(0)
        }
    }

    மாறி s சரம் = "ஆம்"
    திசைவி s {
        எனில் "இல்லை" {
            பதிப்பி(1)
        }
        எனில் "ஆம்" {
            பதிப்பி(2)
        }
        மற்றபடி {
            பதிப்பி(3)
        }
    }

    மாறி x முழுஎண் = -1
    திசைவி {
        எனில் x < 0 {
            பதிப்பி(9)
        }
        எனில் x == 0 {
            பதிப்பி(8)
        }
        மற்றபடி {
            பதிப்பி(7)
        }
    }
}

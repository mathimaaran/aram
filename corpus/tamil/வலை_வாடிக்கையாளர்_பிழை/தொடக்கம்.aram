// Aram: வலை_வாடிக்கையாளர்_பிழை — client URL errors + reserved response headers (Tamil-0.57)

தொகுப்பு தொடக்கம்

கொணர் "வலை"
கொணர் "பரிமாற்றம்"

செயல்பாடு தொடக்கம்() {
    _, பிழை := பரிமாற்றம்.பெறு("https://example.com/")
    எனில் பிழை == இன்மை {
        பதிப்பி("https ok")
    }
    எனில் பிழை != இன்மை {
        பதிப்பி(பிழை.செய்தி)
    }

    _, பிழை2 := பரிமாற்றம்.பெறு("not-a-url")
    எனில் பிழை2 != இன்மை {
        பதிப்பி(பிழை2.செய்தி)
    }

    கேட்பி, _ := வலை.கேள்(":0")
    முக, _ := வலை.முகவரி(கேட்பி)
    இழை செயல்பாடு() {
        இ, _ := வலை.இணை(முக)
        வலை.எழுது(இ, []இருமி8("GET / HTTP/1.0\r\n\r\n"))
        இடம் := ஆக்கு([]இருமி8, 256)
        வலை.படி(இ, இடம்)
        வலை.விடு(இ)
    }()
    பரிமாற்றம்.சேவைஒன்று(கேட்பி, செயல்பாடு(கோ பரிமாற்றம்.கோரிக்கை, ப பரிமாற்றம்.பதிலளிப்பு) {
        தலை := அகராதி[சரம்]சரம்{"Content-Length": "999"}
        பிழை3 := பரிமாற்றம்.எழுதுசரந்தலைப்புகள்(ப, 200, "text/plain; charset=utf-8", தலை, "nope")
        எனில் பிழை3 != இன்மை {
            பதிப்பி(பிழை3.செய்தி)
            பரிமாற்றம்.எழுதுசரம்(ப, 500, "text/plain; charset=utf-8", "reserved")
            திருப்பு
        }
        பரிமாற்றம்.எழுதுசரம்(ப, 200, "text/plain; charset=utf-8", "leak")
    })
    வலை.நிறுத்து(கேட்பி)
}

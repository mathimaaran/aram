// Niraluli: நிலையான.uli — fixed arrays [N]T (Tamil-0.24)

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    அ := [3]முழுஎண்{10, 20, 30}
    பதிப்பி(நீளம்(அ))
    பதிப்பி(திறன்(அ))
    பதிப்பி(அ[1])
    அ[1] = 99
    பதிப்பி(அ[1])

    து := அ[1:3]
    பதிப்பி(நீளம்(து))
    பதிப்பி(து[0])

    கூடு := 0
    சுழல் _, வ := ஒவ்வொரு அ {
        கூடு = கூடு + வ
    }
    பதிப்பி(கூடு)
}

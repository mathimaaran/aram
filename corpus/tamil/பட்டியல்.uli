தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    மாறி எண்கள் []முழுஎண் = []முழுஎண்{10, 20, 30}
    பதிப்பி(நீளம்(எண்கள்))
    பதிப்பி(எண்கள்[1])
    எண்கள்[1] = 99
    பதிப்பி(எண்கள்[1])
    பெயர்கள் := []சரம்{"நிரலுளி", "கோ"}
    பதிப்பி(நீளம்(பெயர்கள்))
    பதிப்பி(பெயர்கள்[0])
}

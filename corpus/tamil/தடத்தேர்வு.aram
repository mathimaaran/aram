// Aram: தடத்தேர்வு.aram — select + close (Tamil-0.48)
// After மூடு, a recv எனில் is still ready (zero value) — so மற்றபடி
// cannot demonstrate "empty" wait. Default is shown on a separate empty chan.

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    ச := ஆக்கு(தடம் முழுஎண், 1)
    ச <- 7
    தடத்தேர்வு {
        எனில் ம := <-ச {
            பதிப்பி(ம)
        }
        மற்றபடி {
            பதிப்பி(0)
        }
    }
    மூடு(ச)
    வெறு := ஆக்கு(தடம் முழுஎண், 1)
    தடத்தேர்வு {
        எனில் ம := <-வெறு {
            பதிப்பி(ம)
        }
        மற்றபடி {
            பதிப்பி(9)
        }
    }
}

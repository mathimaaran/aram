// Niraluli: பலபட்டியல்.uli — nested slices (Tamil-0.21)

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    அ := [][]முழுஎண்{[]முழுஎண்{1, 2}, []முழுஎண்{3, 4, 5}}
    பதிப்பி(நீளம்(அ))
    பதிப்பி(நீளம்(அ[1]))
    பதிப்பி(அ[0][1])
    பதிப்பி(அ[1][2])

    அ = சேர்(அ, []முழுஎண்{9})
    பதிப்பி(நீளம்(அ))
    பதிப்பி(அ[2][0])

    வரிசை := அ[0:2]
    பதிப்பி(நீளம்(வரிசை))
}
